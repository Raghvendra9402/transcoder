{
  "name": "transcode",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "build:trigger": "npx esbuild ./src/trigger.ts --bundle --platform=node --target=node24 --outfile=dist/trigger.js",
    "build:on-complete": "npx esbuild ./src/on-complete.ts --bundle --platform=node --target=node24 --outfile=dist/on-complete.js",
    "build": "bun run build:trigger && bun run build:on-complete"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.162",
    "@types/bun": "latest",
    "@types/pg": "^8.20.0",
    "prisma": "^7.8.0"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@aws-sdk/client-mediaconvert": "^3.1085.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "dotenv": "^17.4.2",
    "pg": "^8.22.0"
  }
}
